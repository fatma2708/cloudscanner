# ---- Backend ----
DATABASE_URL=postgresql+psycopg://cloudpilot:cloudpilot@localhost:5432/cloudpilot
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000

# Storage root for uploaded artifacts
STORAGE_ROOT=./storage

# ---- LLM (optional). If unset, CloudPilot uses its built-in heuristic engine. ----
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# For a free local model: install Ollama, `ollama pull llama3.1`, then set
# LLM_PROVIDER=openai, OPENAI_BASE_URL=http://localhost:11434/v1, OPENAI_API_KEY=ollama, OPENAI_MODEL=llama3.1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ---- OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
